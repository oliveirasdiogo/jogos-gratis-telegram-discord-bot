{
  "name": "jogos-gratis-telegram-discord-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Bot serverless para Telegram e Discord que avisa sobre jogos grátis para PC.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oliveirasdiogo/jogos-gratis-telegram-discord-bot.git"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "db:migrate:local": "wrangler d1 migrations apply jogos-gratis-multiplataforma --local",
    "db:migrate:remote": "wrangler d1 migrations apply jogos-gratis-multiplataforma --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260728.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "wrangler": "4.114.0"
  }
}
